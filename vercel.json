{
  "rewrites": [
    {
      "source": "/proxy/:path*",
      "destination": "/api/proxy/:path*"
    },
    {
      "source": "/s=:query",
      "destination": "/index.html"
    },
    {
      "source": "/player.html",
      "destination": "/player.html"
    },
    {
      "source": "/player.html/:path*",
      "destination": "/player.html"
    },
    // 在这里插入下面这一段，放在 /:path* 之前
    {
      "source": "/tmdb-proxy",
      "destination": "/api/tmdb-proxy"
    },
    // 保持兜底规则在最后
    {
      "source": "/:path*",
      "destination": "/:path*"
    }
  ]
}
